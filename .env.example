# === Required ===
BOT_TOKEN=your_telegram_bot_token
CHAT_ID=your_telegram_chat_id
WALLET_API_KEY=your_wallet_p2p_api_key

# === Bybit ===
# Ключи Bybit НЕ нужны и НЕ используются. Источник цен Bybit — публичный эндпоинт
# (taker feed), он совпадает с тем, что видно в UI Bybit, и работает без ключа.
# Если в .env остались BYBIT_API_KEY/BYBIT_API_SECRET/BYBIT_API_BASE — их можно удалить.

# === Monitoring Settings ===
CHECK_INTERVAL=30          # Check interval in seconds
CRYPTO_CURRENCY=USDT       # Crypto currency to monitor

# === Threshold ===
SELL_THRESHOLD_KZT=        # Alert when buy price <= this (e.g. 445)

# === Ad limit filter (KZT) ===
# Учитываются только объявления, чей лимит [minAmount, maxAmount] пересекается
# с этим диапазоном. Пример: 0-500000 отсекает «1 000 000–5 000 000».
MIN_LIMIT_KZT=0            # Min ad amount (0 = without lower bound)
MAX_LIMIT_KZT=             # Max ad amount (empty = without upper bound)

# === Server ===
PORT=3000                  # Express keep-alive port
